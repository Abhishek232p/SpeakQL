NODE_ENV=development
LOG_LEVEL=info
# Runtime only: dedicated unprivileged LOGIN member of speakql_runtime; never the table owner.
DATABASE_URL=postgresql://speakql_app:replace-me@localhost:5432/speakql
# Drizzle CLI only: a separate schema/migration administrator. Do not deploy this secret to the app.
# Neither URL falls back to the other. See docs/DATABASE_SECURITY.md before provisioning roles.
MIGRATION_DATABASE_URL=postgresql://speakql_migrator:replace-me@localhost:5432/speakql
# Required for live Supabase Auth. Keep these server configuration values out of commits.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Phase 2 live security harness only. Use a disposable database and three
# separate LOGIN roles: an administrator for fixture setup/cleanup plus two
# LOGIN members of speakql_runtime. The harness never applies migrations.
# SPEAKQL_SECURITY_TEST_ALLOW_MUTATION=1
# SPEAKQL_SECURITY_TEST_DISPOSABLE_MARKER=owner-approved-test
# SPEAKQL_SECURITY_TEST_ADMIN_DATABASE_URL=postgresql://fixture_admin:replace-me@localhost:5432/speakql_disposable
# SPEAKQL_SECURITY_TEST_ALICE_DATABASE_URL=postgresql://speakql_alice:replace-me@localhost:5432/speakql_disposable
# SPEAKQL_SECURITY_TEST_BOB_DATABASE_URL=postgresql://speakql_bob:replace-me@localhost:5432/speakql_disposable
